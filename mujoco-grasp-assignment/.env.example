# Never commit a populated .env file. Export these variables in the shell that
# runs the evaluator, or copy this file to .env and source it locally.
GRASPBENCH_VLM_BASE_URL=https://YOUR_OPENAI_COMPATIBLE_HOST/compatible-mode/v1
GRASPBENCH_VLM_API_KEY=replace-with-a-secret-managed-key
GRASPBENCH_VLM_MODEL=qwen3-vl-flash
GRASPBENCH_VLM_RESPONSE_FORMAT=json_object
GRASPBENCH_VLM_TIMEOUT_S=45

# The local SAM3 adapter may be hosted anywhere. The expected endpoint accepts
# POST /infer and its service root must expose GET /healthz.
GRASPBENCH_SAM3_URL=http://127.0.0.1:8765/infer
