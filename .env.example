# Optional overrides. Defaults work when the service runs on this machine.
GRASPBENCH_YOLO_URL=http://127.0.0.1:8765/infer
YOLO_WEIGHTS=yolo/best.pt
YOLO_CONF=0.25
# GPU 0 runs YOLO on the course workstation.  Override this on machines with
# a different CUDA layout; use "cpu" only as an explicit fallback.
YOLO_DEVICE=0
YOLO_PORT=8765
